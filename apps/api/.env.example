# Copy to .env. On Railway, DATABASE_URL is referenced from the Postgres service
# (use the private network URL: *.railway.internal).
DATABASE_URL=postgres://dndficha:dndficha@localhost:5432/dndficha
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Password recovery without email: ADMIN_TOKEN (>= 32 characters) enables
# POST /admin/reset-tokens. WEB_URL makes it return the full link.
# ADMIN_TOKEN=
# WEB_URL=http://localhost:3000

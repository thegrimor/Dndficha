# Copiar a .env. En Railway, DATABASE_URL se referencia desde el servicio Postgres
# (usar la URL de red privada: *.railway.internal).
DATABASE_URL=postgres://dndficha:dndficha@localhost:5432/dndficha
PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Recuperación de contraseña sin correo: con ADMIN_TOKEN (>=32 caracteres) se habilita
# POST /admin/reset-tokens. WEB_URL hace que devuelva el enlace completo.
# ADMIN_TOKEN=
# WEB_URL=http://localhost:3000
